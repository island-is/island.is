# vi: ft=gitignore

# Known ignores
/.github/
# A runtime input of the Nx builds (`forceRebuild` in nx.json). Without it the builds in a Docker
# build don't have the hash of the same builds on a runner, and changing it does nothing in here
!/.github/actions/force-build.mjs
/.git/
/scripts/ci/
/.env.*
/.envrc*
/.nx/

# Cache and packages
**/node_modules/
# Ignoring _all_ cache folders dosen't work, because we have libraries named `cache`
# **/cache/
/.yarn/cache/
# Ignores e.g. `cache/` and `cache_outptut/`
/cache*
/.cache*/

# Logs and temporaries
**/log/
**/*.log
**/tmp/
**/temp/
**/.next/

# Outputs
**/out/
/dist/

# Docker-stuff
**/Dockerfile
**/Dockerfile.*
**/Containerfile
**/Containerfile.*
**/*-compose.yaml
**/*-compose.yml
