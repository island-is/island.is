{
  "name": "form-system-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/form-system/web/src",
  "projectType": "application",
  "tags": ["scope:form-system"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/form-system/web/vite.config.ts"
      },
      "configurations": {
        "production": {}
      },
      "outputs": ["{workspaceRoot}/dist/apps/form-system/web"],
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite serve --config apps/form-system/web/vite.config.ts"
      },
      "configurations": {
        "production": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/form-system/web/jest.config.ts"
      }
    },
    "start-bff": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["yarn infra run-local-env services-bff-portals-my-pages"],
        "cwd": "infra"
      }
    },
    "extract-strings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn ts-node -P libs/localization/tsconfig.lib.json libs/localization/scripts/extract 'apps/form-system/web/src/{app,components,routes,lib}/**/*.{js,ts,tsx}'"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "./scripts/run-xroad-proxy.sh",
          "yarn nx run services-user-profile:dev",
          "yarn start service-portal",
          "yarn nx run form-system-web:start-bff",
          "yarn start form-system-web"
        ],
        "parallel": true
      }
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["API_MOCKS=true yarn start form-system-web"]
      }
    },
    "docker-static": {
      "executor": "Intentionally left blank, only so this target is valid when using `nx show projects --with-target docker-static`"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/form-system/web/tsconfig.app.json"
      },
      "cache": true,
      "inputs": ["production", "^production"]
    }
  }
}
