{
  "openapi": "3.0.4",
  "info": {
    "title": "FST.Islandis.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://islandis-sm-api-test.fjarskiptastofa.is/"
    }
  ],
  "paths": {
    "/v1/assessment/categories": {
      "get": {
        "tags": ["Self-assessment"],
        "description": "Returns the question categories.",
        "operationId": "GetQuestionCategories",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionCategoriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assessment/is-regulated": {
      "get": {
        "tags": ["Self-assessment"],
        "description": "Returns whether the entity is supervised and the access window is open.",
        "operationId": "GetIsRegulated",
        "parameters": [
          {
            "name": "SSN",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IsRegulatedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assessment/questions": {
      "get": {
        "tags": ["Self-assessment"],
        "description": "Returns the questionnaire.",
        "operationId": "GetQuestions",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "nullable": true
                    },
                    "title": {
                      "type": "string",
                      "nullable": true
                    },
                    "status": {
                      "pattern": "^-?(?:0|[1-9]\\d*)$",
                      "format": "int32",
                      "nullable": true,
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string",
                      "nullable": true
                    },
                    "instance": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/assessment/submit": {
      "post": {
        "tags": ["Self-assessment"],
        "description": "Submits a set of answers and scores them.",
        "operationId": "SubmitAnswers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswersRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerCategoryScore": {
        "required": ["categoryId", "score"],
        "type": "object",
        "properties": {
          "categoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "type": "integer"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double",
            "type": "number"
          }
        }
      },
      "AnswerRequest": {
        "required": ["questionId", "answerValue"],
        "type": "object",
        "properties": {
          "questionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "type": "integer"
          },
          "answerValue": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "remark": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AnswersRequest": {
        "required": ["submitterSSN", "assessmentResponses"],
        "type": "object",
        "properties": {
          "submitterSSN": {
            "type": "string"
          },
          "assessmentResponses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerRequest"
            }
          }
        }
      },
      "AnswersResponse": {
        "required": ["averageOverallScore", "categoryScores"],
        "type": "object",
        "properties": {
          "averageOverallScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double",
            "type": "number"
          },
          "categoryScores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerCategoryScore"
            }
          }
        }
      },
      "AnswerStatus": {
        "enum": ["No", "InProgress", "InAdoption", "Yes"]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "IsRegulatedResponse": {
        "required": ["isSupervisedEntity", "accessWindowOpen"],
        "type": "object",
        "properties": {
          "isSupervisedEntity": {
            "type": "boolean"
          },
          "accessWindowOpen": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuestionCategoriesResponse": {
        "required": ["categoryList"],
        "type": "object",
        "properties": {
          "categoryList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionCategoryResponse"
            }
          }
        }
      },
      "QuestionCategoryResponse": {
        "required": ["id", "label", "shortLabel"],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "shortLabel": {
            "type": "string"
          }
        }
      },
      "QuestionResponse": {
        "required": ["id", "categoryId", "questionText", "tooltip"],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "type": "integer"
          },
          "categoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "type": "integer"
          },
          "questionText": {
            "type": "string"
          },
          "tooltip": {
            "type": "string"
          }
        }
      },
      "QuestionsResponse": {
        "required": ["questionList"],
        "type": "object",
        "properties": {
          "questionList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Self-assessment"
    }
  ]
}
