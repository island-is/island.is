{
  "name": "application-templates-parental-leave-v2",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/application/templates/parental-leave-v2/src",
  "projectType": "library",
  "tags": ["lib:application-system", "scope:application-system"],
  "generators": {},
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/application/templates/parental-leave-v2/jest.config.ts"
      },
      "outputs": [
        "{workspaceRoot}/coverage/libs/application/templates/parental-leave-v2"
      ]
    },
    "extract-strings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn ts-node -P libs/localization/tsconfig.lib.json libs/localization/scripts/extract libs/application/templates/parental-leave-v2/src/lib/messages.ts"
      }
    },
    "codegen/frontend-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --config libs/application/templates/parental-leave-v2/codegen.yml"
      }
    }
  }
}
